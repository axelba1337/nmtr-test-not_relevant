APP_NAME=Neomatra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neomatra
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

GEMINI_API_KEY=
# Legacy model fallbacks retained for backward compatibility.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIMENSIONS=768

CHAT_PROVIDER=gemini
CHAT_API_KEY="${GEMINI_API_KEY}"
CHAT_MODEL=gemini-3.1-flash-lite
CHAT_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CHAT_INTENT_MAX_OUTPUT_TOKENS=512
CHAT_MAX_OUTPUT_TOKENS=512
CHAT_MAX_CONTEXT_CHARS=12000
CHAT_HISTORY_MAX_MESSAGES=6
CHAT_HISTORY_MAX_CHARS=12000
CHAT_WEB_GROUNDING_ENABLED=true
CHAT_WEB_MODEL=gemini-2.5-flash
CHAT_WEB_MAX_OUTPUT_TOKENS=1024
CHAT_WEB_MAX_ANSWER_CHARS=8000
CHAT_WEB_MAX_SOURCES=5

EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY="${GEMINI_API_KEY}"
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

AI_HTTP_TIMEOUT=30
AI_HTTP_RETRIES=2
AI_HTTP_RETRY_DELAY_MS=1000

MARKETPLACE_PROVIDER=manual-import
MARKETPLACE_SYNC_MODE=manual
MARKETPLACE_TARGETS=tokopedia,shopee,olx,facebook,carousell
MARKETPLACE_PAGE_SIZE=100
MARKETPLACE_MAX_PAGES=25
MARKETPLACE_SYNC_LOCK_SECONDS=300

# Optional public-web OLX connector settings. Automatic Listing uses Tavily.
OLX_BASE_URL=https://www.olx.co.id
OLX_SEARCH_TERMS="rtx 3060 12gb"
OLX_MAX_LISTINGS=20
OLX_HTTP_TIMEOUT=12
OLX_HTTP_RETRIES=1
OLX_HTTP_RETRY_DELAY_MS=250
OLX_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36"

TAVILY_API_KEY=
TAVILY_API_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_SEARCH_MAX_RESULTS=20
TAVILY_SEARCH_COUNTRY=indonesia
TAVILY_EXTRACT_ENABLED=true
TAVILY_EXTRACT_FALLBACK_ONLY=true
TAVILY_EXTRACT_DEPTH=basic
TAVILY_EXTRACT_MAX_URLS_PER_PRODUCT=3

LISTING_DISCOVERY_ENABLED=true
LISTING_DISCOVERY_PROVIDER=tavily
LISTING_DISCOVERY_REGION=Indonesia
LISTING_DISCOVERY_MIN_ACTIVE_LISTINGS=2
LISTING_DISCOVERY_TARGET_ACTIVE_LISTINGS=3
LISTING_DISCOVERY_MAX_PRODUCTS_PER_RUN=100
LISTING_DISCOVERY_RETRY_COOLDOWN_HOURS=24
LISTING_RESEARCH_PROMPT_MAX_PRODUCTS=25
LISTING_DISCOVERY_MAX_NEW_LISTINGS_PER_PRODUCT=3
LISTING_DISCOVERY_MAX_PER_PLATFORM_PER_PRODUCT=2
LISTING_DISCOVERY_REQUIRE_APPROVAL=true
LISTING_DISCOVERY_AUTO_IMPORT=false
LISTING_DISCOVERY_SCHEDULE_ENABLED=false
LISTING_DISCOVERY_CRON="0 2 * * *"
LISTING_DISCOVERY_HTTP_TIMEOUT=30
LISTING_DISCOVERY_HTTP_RETRIES=1
LISTING_DISCOVERY_HTTP_RETRY_DELAY_MS=1000
LISTING_DISCOVERY_HTTP_PROBE_ENABLED=true
LISTING_DISCOVERY_HTTP_PROBE_TIMEOUT=8
LISTING_DISCOVERY_PLATFORM_FALLBACK_ENABLED=true
LISTING_DISCOVERY_PLATFORM_FALLBACK_MAX_SEARCHES_PER_PRODUCT=2
LISTING_DISCOVERY_SEARCH_CACHE_HOURS=24
LISTING_DISCOVERY_CANDIDATE_RETENTION_DAYS=7

QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

NEOMATRA_DEFAULT_CURRENCY=IDR
NEOMATRA_PRODUCT_CANDIDATE_K=20
NEOMATRA_RESULT_TOP_K=5
NEOMATRA_KNOWLEDGE_TOP_K=3
NEOMATRA_LISTING_STALE_AFTER_HOURS=168
NEOMATRA_UNANSWERED_RETENTION_DAYS=30

CHATBOT_RATE_LIMIT=20
CHATBOT_SOFT_TIMEOUT_SECONDS=20
CHATBOT_HARD_TIMEOUT_SECONDS=30

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
